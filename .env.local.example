# ============================================================
# Configuration PDF to TXT (toutes valeurs optionnelles)
# Copier ce fichier en .env.local et ajuster si nécessaire.
# ============================================================

# Répertoire racine des données locales (PDF, TXT, base SQLite).
# Chemin relatif = depuis la racine du projet. Par défaut : ./data
# DATA_DIR=./data

# Nombre maximal de conversions pdftotext simultanées (défaut : 4)
# MAX_CONCURRENT_CONVERSIONS=4

# Chemin de l'exécutable pdftotext (défaut : "pdftotext", doit être dans le PATH)
# PDFTOTEXT_PATH=pdftotext

# Port du serveur Next.js (défaut : 3000)
# PORT=3000
